{
  "name": "dsh-fairy-zzz-for-jediliu",
  "version": "1.0.2",
  "description": "Fairy 主题：H.D.D 启动动画、眼核、问候与可选本地 TTS。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "theme",
    "skin",
    "zenless-zone-zero",
    "fairy",
    "tts"
  ],
  "exports": {
    ".": "./index.js",
