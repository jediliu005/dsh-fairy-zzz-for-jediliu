{
  "name": "dsh-fairy-zzz-for-jediliu",
  "version": "1.0.0-for-jediliu.1",
  "description": "Personal build of the Fairy skin for DSH (H.D.D boot animation, eye core, greeting, optional local TTS).",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "theme",
    "skin",
    "zenless-zone-zero",
    "fairy",
    "tts"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./assets/icon-180.png"
  },
  "icon": "assets/icon-180.png",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE-fairy-dsh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
